@inherits LayoutComponentBase
@using YardManagementSim.Models
<main>   
    <div class="yard-layout">
        <div class="top-banner">YMS</div>
        <div class="top-banner-div">
            <div class="DIV1">D1</div>
            <div class="DIV2">D2</div>
            <div class="DIV3">D3</div>
            <div class="DIV4">D4</div>
            <div class="DIV5">D5</div>
        </div>
        <div class="top-banner-header">
            <div class="Box1">B1</div>
            <div class="Box2">B2</div>
            <div class="Box3">B3</div>
            <div class="Box4">B4</div>
            <div class="Box5">B5</div>
        </div>
        <div class="main-div">
            <div class="DIV1">D1</div>
            <div class="DIV2">D2</div>
            <div class="DIV3">D3</div>
            <div class="DIV4">D4</div>
            <div class="DIV5">D5</div>
        </div>
        <div class="main">
            @foreach (var slot in YardSlots)
            {
                <div class="slip">
                    <div class="slot-code">@slot.Code</div>
                    <div class="trailer">@slot.Trailer</div>
                    <div class="loadid">@slot.LoadId</div>
                    <div class="Seal">@slot.Seal</div>
                    <div class="notes">@slot.Notes</div>
                </div>
            }
        </div>
    </div>
</main>

@code {
    private List<YardSlot> YardSlots = new();

    protected override void OnInitialized()
    {
        YardSlots.AddRange(GenerateSlots("DD", 102, 178));
        YardSlots.AddRange(GenerateSlots("PS", 501, 630));
        YardSlots.AddRange(GenerateSlots("PS", 701, 741));
        YardSlots.AddRange(GenerateSlots("PS", 201, 234));
    }

    private List<YardSlot> GenerateSlots(string prefix, int start, int end)
    {
        var slots = new List<YardSlot>();

        for (int i = start; i <= end; i++)
        {
            slots.Add(new YardSlot
                {
                    Code = $"{prefix}{i}",
                    Trailer = "",
                    LoadId = "",
                    Seal="",
                    Notes = ""
                });
        }
        return slots;
    }
}