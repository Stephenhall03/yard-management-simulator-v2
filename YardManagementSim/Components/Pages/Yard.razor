@page "/"
@page "/yard"

@using Microsoft.EntityFrameworkCore
@using YardManagementSim.Data
@using YardManagementSim.Models

@inject YardDbContext Db

<div class="yard-header">
    <select @bind="SelectedSlotId">
        <option value="">Select empty slip</option>
        @foreach (var slot in EmptySlots)
        {
            <option value="@slot.Id">@slot.Code</option>
        }
    </select>

    <input placeholder="Trailer Number" @bind="CheckInTrailerNumber" />
    <input placeholder="Load ID" @bind="CheckInLoadId" />
    <input placeholder="Seal" @bind="CheckInSeal" />
    <input placeholder="Notes" @bind="CheckInNotes" />

    <button @onclick="CheckInTrailer">Check In</button>
    <button @onclick="CheckOutTrailer" disabled="@(SelectedGridSlot == null)">Check Out</button>
</div>

<div class="main-div">
    <div>Slip</div>
    <div>Trailer</div>
    <div>Load ID</div>
    <div>Seal</div>
    <div>Notes</div>
</div>

<div class="main">
    @foreach (var slot in YardSlots)
    {
        <div class="slip @(SelectedGridSlot?.Id == slot.Id ? "selected" : "")"
             @onclick="() => SelectGridSlot(slot)">

            <div class="slot-code">@slot.Code</div>
            <div class="trailer">@slot.Trailer</div>
            <div class="loadid">@slot.LoadId</div>
            <div class="seal">@slot.Seal</div>
            <div class="notes">@slot.Notes</div>
        </div>
    }
</div>

@code {
    private List<YardSlot> YardSlots = new();
    private List<YardSlot> EmptySlots => YardSlots
        .Where(s => string.IsNullOrWhiteSpace(s.Trailer))
        .ToList();

    private int? SelectedSlotId;
    private YardSlot? SelectedGridSlot;

    private string CheckInTrailerNumber = "";
    private string CheckInLoadId = "";
    private string CheckInSeal = "";
    private string CheckInNotes = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await Db.YardSlots.AnyAsync())
        {
            Db.YardSlots.AddRange(GenerateSlots("DD", 102, 178));
            Db.YardSlots.AddRange(GenerateSlots("PS", 501, 630));
            Db.YardSlots.AddRange(GenerateSlots("PS", 701, 741));
            Db.YardSlots.AddRange(GenerateSlots("PS", 201, 234));

            await Db.SaveChangesAsync();
        }

        await LoadSlots();
    }

    private async Task LoadSlots()
    {
        YardSlots = await Db.YardSlots
            .OrderBy(s => s.Code)
            .ToListAsync();
    }

    private void SelectGridSlot(YardSlot slot)
    {
        SelectedGridSlot = slot;
    }

    private async Task CheckInTrailer()
    {
        if (SelectedSlotId is null)
            return;

        var slot = await Db.YardSlots.FindAsync(SelectedSlotId.Value);

        if (slot is null)
            return;

        slot.Trailer = CheckInTrailerNumber;
        slot.LoadId = CheckInLoadId;
        slot.Seal = CheckInSeal;
        slot.Notes = CheckInNotes;

        await Db.SaveChangesAsync();

        CheckInTrailerNumber = "";
        CheckInLoadId = "";
        CheckInSeal = "";
        CheckInNotes = "";
        SelectedSlotId = null;

        await LoadSlots();
    }

    private async Task CheckOutTrailer()
    {
        if (SelectedGridSlot is null)
            return;

        var slot = await Db.YardSlots.FindAsync(SelectedGridSlot.Id);

        if (slot is null)
            return;

        slot.Trailer = "";
        slot.LoadId = "";
        slot.Seal = "";
        slot.Notes = "";

        await Db.SaveChangesAsync();

        SelectedGridSlot = null;
        await LoadSlots();
    }

    private List<YardSlot> GenerateSlots(string prefix, int start, int end)
    {
        var slots = new List<YardSlot>();

        for (int i = start; i <= end; i++)
        {
            slots.Add(new YardSlot
            {
                Code = $"{prefix}{i}"
            });
        }

        return slots;
    }
}