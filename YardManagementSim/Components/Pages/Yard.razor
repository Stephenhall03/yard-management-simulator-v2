@page "/"
@page "/yard"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using YardManagementSim.Data
@using YardManagementSim.Models

@inject YardDbContext Db

<div class="yard-page">

    <div class="yard-top-banner">
        <span>YMS — Yard Management System</span>
        <a href="/tc" class="nav-switch-btn">&#128666; TC View</a>
    </div>

    <div class="yard-toolbar">
        <select value="@SelectedSlotId" @onchange="OnSlotSelected">
            <option value="">— Select slip —</option>
            @foreach (var slot in EmptySlots)
            {
                <option value="@slot.Id">@slot.Code</option>
            }
        </select>
        <input placeholder="Trailer #" @bind="CheckInTrailerNumber" @bind:event="oninput" />
        <input placeholder="Load ID" @bind="CheckInLoadId" @bind:event="oninput" />
        <input placeholder="Seal" @bind="CheckInSeal" @bind:event="oninput" />
        <input placeholder="Notes" @bind="CheckInNotes" @bind:event="oninput" />
        <button class="btn-checkin" @onclick="CheckInTrailer">&#10004; Check In</button>
        <button class="btn-checkout" @onclick="CheckOutTrailer"
                disabled="@(SelectedGridSlot == null)">
            &#10008; Check Out
        </button>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="status-bar @(StatusIsError ? "status-error" : "status-ok")">
            @StatusMessage
        </div>
    }

    <div class="yard-grid-wrapper">

        <!-- DD Section -->
        <div class="yard-grid">
            <div class="section-banner banner-blue">DD Dock Slips</div>
            <div class="col-header">Slip</div>
            <div class="col-header">Trailer #</div>
            <div class="col-header">Load ID</div>
            <div class="col-header">Seal</div>
            <div class="col-header">Notes</div>
            <div class="col-header">Status</div>

            @foreach (var slot in YardSlots.Where(s => s.Code.StartsWith("DD")))
            {
                var sel = SelectedGridSlot?.Id == slot.Id ? "selected" : "";
                var occupied = !string.IsNullOrWhiteSpace(slot.Trailer);

                <div class="slip-code @sel" @onclick="() => SelectGridSlot(slot)">@slot.Code</div>
                <div class="slip-cell cell-trailer @sel" @onclick="() => SelectGridSlot(slot)">@slot.Trailer</div>
                <div class="slip-cell cell-loadid  @sel" @onclick="() => SelectGridSlot(slot)">@slot.LoadId</div>
                <div class="slip-cell cell-seal    @sel" @onclick="() => SelectGridSlot(slot)">@slot.Seal</div>
                <div class="slip-cell cell-notes   @sel" @onclick="() => SelectGridSlot(slot)">@slot.Notes</div>
                <div class="slip-cell cell-status  @sel" @onclick="() => SelectGridSlot(slot)">
                    @if (occupied)
                    {
                        <button class="btn-move" @onclick:stopPropagation="true"
                                @onclick="() => OnSlotMoveClicked(slot)">
                            &#8594; Move
                        </button>
                    }
                    else
                    {
                        <span class="badge badge-empty">Empty</span>
                    }
                </div>
            }
        </div>

        <!-- PS Section -->
        <div class="yard-grid" style="margin-top: 16px;">
            <div class="section-banner banner-red">PS Dock Slips</div>
            <div class="col-header">Slip</div>
            <div class="col-header">Trailer #</div>
            <div class="col-header">Load ID</div>
            <div class="col-header">Seal</div>
            <div class="col-header">Notes</div>
            <div class="col-header">Status</div>

            @foreach (var slot in YardSlots.Where(s => s.Code.StartsWith("PS")))
            {
                var sel = SelectedGridSlot?.Id == slot.Id ? "selected" : "";
                var occupied = !string.IsNullOrWhiteSpace(slot.Trailer);

                <div class="slip-code @sel" @onclick="() => SelectGridSlot(slot)">@slot.Code</div>
                <div class="slip-cell cell-trailer @sel" @onclick="() => SelectGridSlot(slot)">@slot.Trailer</div>
                <div class="slip-cell cell-loadid  @sel" @onclick="() => SelectGridSlot(slot)">@slot.LoadId</div>
                <div class="slip-cell cell-seal    @sel" @onclick="() => SelectGridSlot(slot)">@slot.Seal</div>
                <div class="slip-cell cell-notes   @sel" @onclick="() => SelectGridSlot(slot)">@slot.Notes</div>
                <div class="slip-cell cell-status  @sel" @onclick="() => SelectGridSlot(slot)">
                    @if (occupied)
                    {
                        <button class="btn-move" @onclick:stopPropagation="true"
                                @onclick="() => OnSlotMoveClicked(slot)">
                            &#8594; Move
                        </button>
                    }
                    else
                    {
                        <span class="badge badge-empty">Empty</span>
                    }
                </div>
            }
        </div>

        <!-- Driver Move List 
        <div class="move-list-section">
            <div class="move-list-header" @onclick="ToggleMoveList">
                &#128666; Driver Move List (@MoveList.Count)
                <span class="move-list-toggle">@(ShowMoveList ? "▲ Hide" : "▼ Show")</span>
            </div>

            @if (ShowMoveList)
            {
                @if (!MoveList.Any())
                {
                    <div class="move-list-empty">No moves queued yet.</div>
                }
                else
                {
                    <div class="move-list-grid">
                        <div class="move-col-header">Trailer #</div>
                        <div class="move-col-header">From</div>
                        <div class="move-col-header"></div>
                        <div class="move-col-header">To</div>
                        <div class="move-col-header">Status</div>
                        <div class="move-col-header"></div>

                        @foreach (var move in MoveList)
                        {
                            var rowClass = move.Completed ? "move-row-done" : "move-row-pending";
                            <div class="move-cell move-trailer @rowClass">@move.Trailer</div>
                            <div class="move-cell move-from    @rowClass">@move.FromSlip</div>
                            <div class="move-cell move-arrow   @rowClass">&#8594;</div>
                            <div class="move-cell move-to      @rowClass">@move.ToSlip</div>
                            <div class="move-cell @rowClass">
                                <span class="badge @(move.Completed ? "badge-occupied" : "badge-pending")">
                                    @(move.Completed ? "Done" : "Pending")
                                </span>
                            </div>
                            <div class="move-cell @rowClass">
                                @if (!move.Completed)
                                {
                                    <button class="btn-complete" @onclick="() => CompleteMove(move)">
                                        &#10004; Done
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div> -->

    </div>
</div>

<!-- Move Popup -->
@if (ShowMovePopup && MoveSourceSlot != null)
{
    <div class="popup-overlay" @onclick="CloseMovePopup">
        <div class="popup-box" @onclick:stopPropagation="true">
            <div class="popup-title">&#128666; Move Trailer</div>

            <div class="popup-from">
                <span class="popup-label">From:</span>
                <strong>@MoveSourceSlot.Code</strong>
                &nbsp;&nbsp;
                <span class="popup-label">Trailer:</span>
                <strong>@MoveSourceSlot.Trailer</strong>
            </div>

            <div class="popup-field">
                <label class="popup-label">Move to slip:</label>
                <select class="popup-select" value="@MoveTargetSlotId" @onchange="OnMoveTargetSelected">
                    <option value="">— Select destination —</option>
                    @foreach (var slot in EmptySlots)
                    {
                        <option value="@slot.Id">@slot.Code</option>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(PopupError))
            {
                <div class="popup-error">@PopupError</div>
            }

            <div class="popup-actions">
                <button class="btn-cancel" @onclick="CloseMovePopup">Cancel</button>
                <button class="btn-confirm" @onclick="ConfirmMove">&#10004; Confirm Move</button>
            </div>
        </div>
    </div>
}

@code {
    private List<YardSlot> YardSlots = new();
    private List<YardMove> MoveList = new();

    private List<YardSlot> EmptySlots => YardSlots
        .Where(s => string.IsNullOrWhiteSpace(s.Trailer))
        .ToList();

    // Check-in form
    private int? SelectedSlotId;
    private YardSlot? SelectedGridSlot;
    private string CheckInTrailerNumber = "";
    private string CheckInLoadId = "";
    private string CheckInSeal = "";
    private string CheckInNotes = "";

    // Status bar
    private string StatusMessage = "";
    private bool StatusIsError = false;

    // Move popup
    private bool ShowMovePopup = false;
    private YardSlot? MoveSourceSlot = null;
    private int? MoveTargetSlotId = null;
    private string PopupError = "";

    // Move list panel
    private bool ShowMoveList = true;

    private void OnSlotSelected(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        SelectedSlotId = int.TryParse(raw, out var id) ? id : null;
    }

    private void OnMoveTargetSelected(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        MoveTargetSlotId = int.TryParse(raw, out var id) ? id : null;
        PopupError = "";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await Db.YardSlots.AnyAsync())
        {
            Db.YardSlots.AddRange(GenerateSlots("DD", 102, 178));
            Db.YardSlots.AddRange(GenerateSlots("PS", 501, 630));
            Db.YardSlots.AddRange(GenerateSlots("PS", 701, 741));
            Db.YardSlots.AddRange(GenerateSlots("PS", 201, 234));
            await Db.SaveChangesAsync();
        }

        await LoadSlots();
        await LoadMoveList();
    }

    private async Task LoadSlots()
    {
        YardSlots = await Db.YardSlots.OrderBy(s => s.Code).ToListAsync();
    }

    private async Task LoadMoveList()
    {
        MoveList = await Db.YardMoves.OrderByDescending(m => m.MovedAt).ToListAsync();
    }

    private void SelectGridSlot(YardSlot slot)
    {
        SelectedGridSlot = slot;
        StatusMessage = "";
    }

    // Click on any occupied slip — open move queue popup
    private void OnSlotMoveClicked(YardSlot slot)
    {
        if (!string.IsNullOrWhiteSpace(slot.Trailer))
        {
            MoveSourceSlot = slot;
            MoveTargetSlotId = null;
            PopupError = "";
            ShowMovePopup = true;
        }
        else
        {
            SelectGridSlot(slot);
        }
    }

    private void CloseMovePopup()
    {
        ShowMovePopup = false;
        MoveSourceSlot = null;
        PopupError = "";
    }

    private async Task ConfirmMove()
    {
        if (MoveTargetSlotId is null)
        {
            PopupError = "Please select a destination slip.";
            return;
        }

        var fromSlot = await Db.YardSlots.FindAsync(MoveSourceSlot!.Id);
        var toSlot = await Db.YardSlots.FindAsync(MoveTargetSlotId.Value);

        if (fromSlot is null || toSlot is null)
        {
            PopupError = "Slip not found — please refresh and try again.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(toSlot.Trailer))
        {
            PopupError = "That slip is no longer empty. Please choose another.";
            return;
        }

        // Queue the move — data stays put until the move is completed
        Db.YardMoves.Add(new YardMove
        {
            FromSlip = fromSlot.Code,
            ToSlip = toSlot.Code,
            Trailer = fromSlot.Trailer,
            MovedAt = DateTime.Now,
            Completed = false
        });

        await Db.SaveChangesAsync();

        StatusMessage = $"Move queued: {fromSlot.Trailer} from {fromSlot.Code} → {toSlot.Code}.";
        StatusIsError = false;

        CloseMovePopup();
        await LoadSlots();
        await LoadMoveList();
    }

    private async Task CompleteMove(YardMove move)
    {
        var record = await Db.YardMoves.FindAsync(move.Id);
        if (record is null) return;
        record.Completed = true;
        await Db.SaveChangesAsync();
        await LoadMoveList();
    }

    private void ToggleMoveList() => ShowMoveList = !ShowMoveList;

    private async Task CheckInTrailer()
    {
        StatusMessage = "";

        if (SelectedSlotId is null)
        {
            StatusMessage = "Please select a slip from the dropdown.";
            StatusIsError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(CheckInTrailerNumber))
        {
            StatusMessage = "Please enter a Trailer #.";
            StatusIsError = true;
            return;
        }

        var slot = await Db.YardSlots.FindAsync(SelectedSlotId.Value);
        if (slot is null)
        {
            StatusMessage = $"Slip ID {SelectedSlotId} not found in database.";
            StatusIsError = true;
            return;
        }

        slot.Trailer = CheckInTrailerNumber.Trim();
        slot.LoadId = CheckInLoadId.Trim();
        slot.Seal = CheckInSeal.Trim();
        slot.Notes = CheckInNotes.Trim();

        await Db.SaveChangesAsync();

        StatusMessage = $"Trailer {slot.Trailer} checked in to {slot.Code}.";
        StatusIsError = false;
        CheckInTrailerNumber = "";
        CheckInLoadId = "";
        CheckInSeal = "";
        CheckInNotes = "";
        SelectedSlotId = null;

        await LoadSlots();
    }

    private async Task CheckOutTrailer()
    {
        if (SelectedGridSlot is null) return;

        var slot = await Db.YardSlots.FindAsync(SelectedGridSlot.Id);
        if (slot is null) return;

        var code = slot.Code;
        slot.Trailer = "";
        slot.LoadId = "";
        slot.Seal = "";
        slot.Notes = "";

        await Db.SaveChangesAsync();

        StatusMessage = $"Slip {code} cleared.";
        StatusIsError = false;
        SelectedGridSlot = null;

        await LoadSlots();
    }

    private List<YardSlot> GenerateSlots(string prefix, int start, int end)
    {
        var slots = new List<YardSlot>();
        for (int i = start; i <= end; i++)
            slots.Add(new YardSlot { Code = $"{prefix}{i}" });
        return slots;
    }
}
